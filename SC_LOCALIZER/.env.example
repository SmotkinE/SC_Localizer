# Скопируй в .env и поправь под себя. Все значения необязательные.

# Пути к исходным файлам. По умолчанию берутся из соседних папок старого проекта:
#   ..\english\global.ini  и  ..\russian\global.ini
ENGLISH_INI=
RUSSIAN_INI=
OUTPUT_DIR=

# Веб-сервер
HOST=127.0.0.1
PORT=5000
DEBUG=False

# Логи: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Сколько ключей показывать на странице таблицы
PAGE_SIZE=100

# Откуда программа берёт обновления самой себя (GitHub Releases).
# Пусто — обновление отключено. По умолчанию SmotkinE/SC_Localizer.
UPDATE_REPO=
